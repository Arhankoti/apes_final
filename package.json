    "ci": "npm run lint && npm run build"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "html-minifier-terser": "^7.2.0",
    "htmlhint": "^1.1.4",
    "http-server": "^14.1.1",
    "sharp": "^0.33.4",
    "stylelint": "^16.6.1",
    "stylelint-config-standard": "^36.0.1",
    "vercel": "^54.1.0"
  }
}
