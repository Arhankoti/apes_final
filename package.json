{
  "name": "apes_final",
  "version": "1.0.0",
  "description": "Mountain Pine Beetle Outbreaks — static site",
  "private": true,
  "scripts": {
    "lint:html": "htmlhint '*.html'",
    "lint:css": "stylelint styles.css",
    "lint": "npm run lint:html && npm run lint:css",
    "build": "node build.mjs",
    "serve": "http-server dist -p 3000 -o",
